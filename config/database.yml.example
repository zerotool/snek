development:
  url: <%= ENV.fetch('DATABASE_URL') { 'postgresql://stan@localhost:5433/snek?pool=5&timeout=5000' } %>

test:
  url: <%= ENV.fetch('TEST_DATABASE_URL') { 'postgresql://stan@localhost:5433/snek_test?pool=5&timeout=5000' } %>

production:
  url: postgresql://user:password@localhost/snek_production?pool=5&timeout=5000
